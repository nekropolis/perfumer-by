APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
AUTH_MODEL=Modules\\Users\\Models\\User

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-app-key
REVERB_APP_SECRET=local-app-secret
# Только hostname (perfumer.test), без http:// и без :8080 — для Reverb server / клиентов
REVERB_HOST=localhost
# Laravel шлёт события в Reverb по HTTP; на сервере — 127.0.0.1, не perfumer.test
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Long-running jobs (RunSellerOneParseJob timeout 7200s): retry_after must exceed that.
# DB_QUEUE_RETRY_AFTER=7600
# REDIS_QUEUE_RETRY_AFTER=7600

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SELLER_ONE_PRICE_MARKUP=1.28
SELLER_ONE_PRICE_RATE=3.15
SELLER_ONE_PRICE_FIXED_FEE=7
SELLER_ONE_PRICE_PRECISION=1

# Optional: Vanille import completion notices (https://core.telegram.org/bots/api#sendmessage)
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Курьерская служба ветерОК (города / районы / зоны)
# Включить cron/sync: VETER=true только на production. Staging/dev — не задавать или false.
VETER=false
VETER_BASE_URL=https://xn--b1aga8bi.xn--90ais
VETER_USER_ID=
VETER_API_KEY=
VETER_TIMEOUT=60
# ProfileName из UserAPI GetProfilesJSON → поле Name (не лейбл селекта UI).
# Пример: curl .../UserAPI/UserProfileAPI.asmx/GetProfilesJSON → [{"Name":"Гришкевич Павел","ID":"11911"}]
VETER_PROFILE_NAME=
# ID из того же ответа (справочно; в CreateTickets уходит Name)
VETER_PROFILE_ID=
VETER_MINSK_CITY_ID=
VETER_SENDER_CITY_ID=
VETER_SENDER_STREET_PREFIX=ул.
VETER_SENDER_STREET_NAME=
VETER_SENDER_HOUSE_NUMBER=
VETER_SENDER_KORPUS=
VETER_SENDER_KVARTIRA=

# Legacy OpenCart MySQL (read-only sync from admin orders page)
# Prefer SSH (mysql runs on legacy host). Direct LEGACY_DB_HOST only if remote MySQL is open.
LEGACY_SSH_HOST=
LEGACY_SSH_USER=
LEGACY_SSH_PORT=22
# Private key must be readable by php-fpm (copy out of /root/.ssh):
# LEGACY_SSH_PRIVATE_KEY=/var/www/perfumer-by/backend/storage/app/legacy_ssh/id_ed25519
# LEGACY_SSH_KNOWN_HOSTS=/var/www/perfumer-by/backend/storage/app/legacy_ssh/known_hosts
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# LEGACY_DB_SOCKET=
# LEGACY_DB_PREFIX=

# Server health monitor (cron: server:health-report)
SERVER_MONITOR_ENABLED=true
SERVER_MONITOR_LOG_TAIL_LINES=100
SERVER_MONITOR_MEM_WARN_MB=250
SERVER_MONITOR_MEM_CRITICAL_MB=120
SERVER_MONITOR_DISK_WARN_PERCENT=85
SERVER_MONITOR_DISK_CRITICAL_PERCENT=95
# Prod: perfumer-frontend | Staging (stag.mobiz.by): frontend-staging
SERVER_MONITOR_PM2_PROCESS=perfumer-frontend
SERVER_MONITOR_PM2_USER=deploy
SERVER_MONITOR_SUPERVISOR_PROGRAM=perfumer-queue
SERVER_MONITOR_LOAD_WARN_MULTIPLIER=1.5
SERVER_MONITOR_LOAD_CRITICAL_MULTIPLIER=2
# Локальный Next.js (PM2); не путать с публичным URL — на staging с basic auth / даёт 401.
SERVER_MONITOR_STOREFRONT_HEALTH_URL=http://127.0.0.1:3000

# OTP delivery channels (Viber first, then SMS fallback)
OTP_VIBER_FIRST=true

VIBER_OTP_ENABLED=true
VIBER_OTP_DRIVER=mock
VIBER_OTP_ENDPOINT=
VIBER_OTP_TOKEN=
VIBER_OTP_SENDER=Perfumer
VIBER_OTP_TIMEOUT=5
VIBER_MOCK_REGISTRATION_MODE=all
VIBER_MOCK_REGISTERED_PHONES=

SMS_OTP_ENABLED=true
SMS_OTP_DRIVER=mock
SMS_OTP_ENDPOINT=
SMS_OTP_TOKEN=
SMS_OTP_SENDER=Perfumer
SMS_OTP_TIMEOUT=5

# OTP anti-spam / anti-bot limits
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# 0 = отключить лимит по номеру за 15 минут (полезно, если AUTH_OTP_CAPTCHA_ENABLED=true)
AUTH_OTP_PHONE_LIMIT_15M=3
AUTH_OTP_PHONE_LIMIT_DAY=8
AUTH_OTP_IP_LIMIT_15M=10
AUTH_OTP_IP_PHONE_LIMIT_15M=3
AUTH_OTP_VERIFY_MAX_ATTEMPTS=5
AUTH_OTP_VERIFY_BLOCK_SECONDS=1800

# Smart CAPTCHA (Google reCAPTCHA v3)
AUTH_OTP_CAPTCHA_ENABLED=false
AUTH_OTP_CAPTCHA_TRIGGER_IP_ATTEMPTS=3
AUTH_OTP_CAPTCHA_TRIGGER_IP_PHONE_ATTEMPTS=2
# Optional override; defaults to AUTH_OTP_CAPTCHA_ENABLED
# AUTH_LOGIN_CAPTCHA_ENABLED=false
# AUTH_LOGIN_CAPTCHA_TRIGGER_FAILURES=2
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Отзывы: reCAPTCHA v3 (действие submit_review — см. frontend execute)
REVIEWS_RECAPTCHA_ENABLED=true
REVIEWS_RECAPTCHA_ACTION=submit_review

# Smart catalog search (Meilisearch)
CATALOG_SEARCH_ENABLED=false
CATALOG_SEARCH_LOG_METRICS=true
CATALOG_SEARCH_ASYNC_UPDATES=true
CATALOG_SEARCH_QUEUE_NAME=default
CATALOG_SEARCH_CACHE_TTL_SECONDS=20
CATALOG_SEARCH_RESPONSE_CACHE_TTL_SECONDS=120
CATALOG_SEARCH_MEILI_URL=
CATALOG_SEARCH_MEILI_KEY=
CATALOG_SEARCH_MEILI_INDEX=catalog_products
CATALOG_SEARCH_MEILI_TIMEOUT_SECONDS=2

# SEO Description
SEO_DESCRIPTION_URL=http://192.168.0.20/api
SEO_DESCRIPTION_TOKEN=
SEO_DESCRIPTION_SITE=perfumer
SEO_DESCRIPTION_CONNECT_TIMEOUT=5
SEO_DESCRIPTION_REQUEST_TIMEOUT=20
SEO_DESCRIPTION_GET_RETRIES=2
SEO_DESCRIPTION_RETRY_DELAY_MS=250
SEO_DESCRIPTION_POLL_INTERVAL=5
SEO_DESCRIPTION_DEADLINE=600
SEO_DESCRIPTION_QUEUE=default
SEO_DESCRIPTION_WORK_CHUNK_SIZE=25
SEO_DESCRIPTION_READY_LIMIT=100
SEO_DESCRIPTION_READY_POLL_MINUTES=2

# Next.js ISR revalidation (prod: backend POST after catalog cache bump).
# URL must hit Next.js, NOT Laravel — nginx proxies /api to PHP.
# Prefer loopback (bypasses nginx basic auth): http://127.0.0.1:3000/actions/revalidate
# Or public path with auth_basic off: https://perfumer.by/actions/revalidate
# Secret header: X-Revalidate-Secret (env CATALOG_REVALIDATE_SECRET on Next).
# Local/admin button uses /actions/revalidate-catalog with X-Admin-Authorization (not Authorization).
CATALOG_STOREFRONT_REVALIDATE_URL=
CATALOG_STOREFRONT_REVALIDATE_SECRET=
