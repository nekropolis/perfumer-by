APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
AUTH_MODEL=Modules\\Users\\Models\\User

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SELLER_ONE_PRICE_MARKUP=1.28
SELLER_ONE_PRICE_RATE=3.15
SELLER_ONE_PRICE_FIXED_FEE=7
SELLER_ONE_PRICE_PRECISION=1

# Optional: Vanille import completion notices (https://core.telegram.org/bots/api#sendmessage)
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OTP delivery channels (Viber first, then SMS fallback)
OTP_VIBER_FIRST=true

VIBER_OTP_ENABLED=true
VIBER_OTP_DRIVER=mock
VIBER_OTP_ENDPOINT=
VIBER_OTP_TOKEN=
VIBER_OTP_SENDER=Perfumer
VIBER_OTP_TIMEOUT=5
VIBER_MOCK_REGISTRATION_MODE=all
VIBER_MOCK_REGISTERED_PHONES=

SMS_OTP_ENABLED=true
SMS_OTP_DRIVER=mock
SMS_OTP_ENDPOINT=
SMS_OTP_TOKEN=
SMS_OTP_SENDER=Perfumer
SMS_OTP_TIMEOUT=5

# OTP anti-spam / anti-bot limits
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# 0 = отключить лимит по номеру за 15 минут (полезно, если AUTH_OTP_CAPTCHA_ENABLED=true)
AUTH_OTP_PHONE_LIMIT_15M=3
AUTH_OTP_PHONE_LIMIT_DAY=8
AUTH_OTP_IP_LIMIT_15M=10
AUTH_OTP_IP_PHONE_LIMIT_15M=3
AUTH_OTP_VERIFY_MAX_ATTEMPTS=5
AUTH_OTP_VERIFY_BLOCK_SECONDS=1800

# Smart CAPTCHA (Google reCAPTCHA v3)
AUTH_OTP_CAPTCHA_ENABLED=false
AUTH_OTP_CAPTCHA_TRIGGER_IP_ATTEMPTS=3
AUTH_OTP_CAPTCHA_TRIGGER_IP_PHONE_ATTEMPTS=2
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Отзывы: reCAPTCHA v3 (действие submit_review — см. frontend execute)
REVIEWS_RECAPTCHA_ENABLED=true
REVIEWS_RECAPTCHA_ACTION=submit_review
