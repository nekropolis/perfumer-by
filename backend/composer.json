{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0",
        "phpoffice/phpspreadsheet": "^5.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\Cart\\": "Modules/Cart/app/",
            "Modules\\Cart\\Database\\Factories\\": "Modules/Cart/database/factories/",
            "Modules\\Cart\\Database\\Seeders\\": "Modules/Cart/database/seeders/",
            "Modules\\Catalog\\": "Modules/Catalog/app/",
            "Modules\\Catalog\\Database\\Factories\\": "Modules/Catalog/database/factories/",
            "Modules\\Catalog\\Database\\Seeders\\": "Modules/Catalog/database/seeders/",
            "Modules\\Checkout\\": "Modules/Checkout/app/",
            "Modules\\Checkout\\Database\\Factories\\": "Modules/Checkout/database/factories/",
            "Modules\\Checkout\\Database\\Seeders\\": "Modules/Checkout/database/seeders/",
            "Modules\\ImportExport\\": "Modules/ImportExport/app/",
            "Modules\\Users\\": "Modules/Users/app/",
            "Modules\\Users\\Database\\Factories\\": "Modules/Users/database/factories/",
            "Modules\\Users\\Database\\Seeders\\": "Modules/Users/database/seeders/",
            "Modules\\Warehouse\\": "Modules/Warehouse/app/",
            "Modules\\Warehouse\\Database\\Factories\\": "Modules/Warehouse/database/factories/",
            "Modules\\Warehouse\\Database\\Seeders\\": "Modules/Warehouse/database/seeders/",
            "Modules\\Wishlist\\": "Modules/Wishlist/app/",
            "Modules\\Wishlist\\Database\\Factories\\": "Modules/Wishlist/database/factories/",
            "Modules\\Wishlist\\Database\\Seeders\\": "Modules/Wishlist/database/seeders/",
            "Modules\\Pages\\": "Modules/Pages/app/",
            "Modules\\Pages\\Database\\Factories\\": "Modules/Pages/database/factories/",
            "Modules\\Pages\\Database\\Seeders\\": "Modules/Pages/database/seeders/",
            "Modules\\Loyalty\\": "Modules/Loyalty/app/",
            "Modules\\Loyalty\\Database\\Factories\\": "Modules/Loyalty/database/factories/",
            "Modules\\Loyalty\\Database\\Seeders\\": "Modules/Loyalty/database/seeders/",
            "Modules\\Settings\\": "Modules/Settings/app/",
            "Modules\\Settings\\Database\\Factories\\": "Modules/Settings/database/factories/",
            "Modules\\Settings\\Database\\Seeders\\": "Modules/Settings/database/seeders/",
            "Modules\\Reviews\\": "Modules/Reviews/app/",
            "Modules\\Reviews\\Database\\Factories\\": "Modules/Reviews/database/factories/",
            "Modules\\Reviews\\Database\\Seeders\\": "Modules/Reviews/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
