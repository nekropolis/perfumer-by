# Nginx basic auth — пример для prod/staging (prod.mobiz.by, perfumer.by, …)
#
# 1) Создать пароль:
#    sudo /var/www/perfumer-by/scripts/nginx/setup-basic-auth.sh
#    # или: sudo htpasswd -c /etc/nginx/.htpasswd USERNAME
#
# 2) В server { listen 443 … } после server_name добавить блок ниже.
#    Loopback (127.0.0.1) без пароля — Next.js SSR ходит в /api по 127.0.0.1.
#
# 3) В существующие location добавить auth_basic off; где нужен доступ без пароля.

    set $auth_basic_realm "Restricted";
    if ($remote_addr = 127.0.0.1) { set $auth_basic_realm off; }
    if ($remote_addr = "::1") { set $auth_basic_realm off; }
    auth_basic $auth_basic_realm;
    auth_basic_user_file /etc/nginx/.htpasswd;

# --- Исключения (внутри тех же server { }) ---

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/letsencrypt;
    }

    location = /up {
        auth_basic off;
        try_files $uri /index.php?$query_string;
    }

# 4) Проверка и reload:
#    sudo nginx -t && sudo systemctl reload nginx
#
# 5) Убрать защиту: удалить auth_basic* и set $auth_basic_realm из конфига, reload.
