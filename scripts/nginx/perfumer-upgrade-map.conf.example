# Install once (http context):
#   sudo cp /var/www/perfumer-by/scripts/nginx/perfumer-upgrade-map.conf.example \
#     /etc/nginx/conf.d/perfumer-upgrade-map.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then in location / use:
#   proxy_set_header Upgrade $http_upgrade;
#   proxy_set_header Connection $connection_upgrade;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      "";
}
