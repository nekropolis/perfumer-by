# Опциональная защита staging паролем (nginx basic auth).
#
# 1) Создать пароль:
#    apt install -y apache2-utils
#    htpasswd -c /etc/nginx/.htpasswd-stag USERNAME
#
# 2) В server { } для stag.mobiz.by (внутри listen 443) добавить:
#
#    auth_basic "Staging";
#    auth_basic_user_file /etc/nginx/.htpasswd-stag;
#
# 3) Исключить Let's Encrypt (если certbot по HTTP):
#    location ^~ /.well-known/acme-challenge/ {
#        auth_basic off;
#        root /var/www/letsencrypt;
#    }
#
# 4) nginx -t && systemctl reload nginx
