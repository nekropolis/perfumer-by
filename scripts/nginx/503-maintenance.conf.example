# Nginx: branded 503 during deploy / Next outage
#
# 1) Page readable by www-data:
#    sudo mkdir -p /var/www/perfumer-by/shared
#    sudo cp /var/www/perfumer-by/scripts/nginx/503.html /var/www/perfumer-by/shared/503.html
#    sudo chown deploy:www-data /var/www/perfumer-by/shared /var/www/perfumer-by/shared/503.html
#    sudo chmod 775 /var/www/perfumer-by/shared && sudo chmod 644 /var/www/perfumer-by/shared/503.html
#
# 2) In server { listen 443 … } — replace old error_page / location = /503.html with:

    error_page 502 503 504 @maintenance;

    location @maintenance {
        auth_basic off;
        default_type text/html;
        root /var/www/perfumer-by/shared;
        try_files /503.html =404;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
    }

# 2b) In http {} (e.g. /etc/nginx/conf.d/perfumer-upgrade-map.conf):
#    map $http_upgrade $connection_upgrade {
#        default upgrade;
#        ''      "";
#    }

# 3) ONLY inside location / (not at server level):

    location / {
        if (-f /var/www/perfumer-by/shared/maintenance.on) {
            return 503;
        }

        proxy_pass http://perfumer_next;
        proxy_http_version 1.1;
        proxy_intercept_errors on;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_set_header Upgrade $http_upgrade;
        # Ordinary HTTP must not force Connection: upgrade.
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

# 4) sudo nginx -t && sudo systemctl reload nginx
#
# Expect:
#   curl -sI https://prod.mobiz.by/ | grep -iE 'HTTP|Retry-After|content-length'
#   → HTTP/2 503, Retry-After: 60, content-length ~4000+ (not 206)
#   curl -sI https://prod.mobiz.by/up → 200
