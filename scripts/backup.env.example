# Copy to /etc/perfumer/backup.env (or source from cron) — do not commit secrets.
# Example cron:
#   15 3 * * * set -a; . /etc/perfumer/backup.env; set +a; /var/www/perfumer-by/scripts/backup-db.sh >/dev/null 2>&1

BACKUP_DIR=/var/backups/perfumer
KEEP_COUNT=3
BACKUP_MEDIA=false

BACKUP_REMOTE=backup@31.220.42.4:/data
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_KEEP=1
BACKUP_TRANSPORT=sftp
BACKUP_SSH_KEY=/home/deploy/.ssh/perfumer-backup-ed25519
BACKUP_TIMEOUT=60
BACKUP_GROUP=www-data
