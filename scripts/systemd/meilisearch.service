[Unit]
Description=Meilisearch for perfumer-by
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/lib/meilisearch
Environment="MEILI_NO_ANALYTICS=true"
Environment="MEILI_HTTP_ADDR=127.0.0.1:7700"
Environment="MEILI_DB_PATH=/var/lib/meilisearch"
EnvironmentFile=/var/www/perfumer-by/backend/.env
ExecStart=/usr/local/bin/meilisearch
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/meilisearch.log
StandardError=append:/var/log/meilisearch.log

[Install]
WantedBy=multi-user.target
